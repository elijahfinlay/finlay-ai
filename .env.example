# ===========================================
# Finlay AI - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# Required vars are marked [REQUIRED], optional ones are marked [OPTIONAL].

# [REQUIRED] Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# [REQUIRED] Google AI (Imagen 4 + Veo 3.1)
GOOGLE_AI_API_KEY=

# [OPTIONAL] Kling AI - Video generation
# Uses JWT auth (Access Key + Secret Key), not a simple API key
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# [OPTIONAL] Mux - Video hosting & streaming
# If not set, videos fall back to HTML5 <video> with direct URLs
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# [REQUIRED for production] Vercel Blob - File storage
# Get from Vercel dashboard → Storage → Create Blob Store
BLOB_READ_WRITE_TOKEN=

# [OPTIONAL] Upstash Redis - Rate limiting
# If not set, rate limiting is disabled (all requests allowed)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# [REQUIRED] Cron job authentication
CRON_SECRET=generate-a-random-secret-here

# [REQUIRED] App URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000
